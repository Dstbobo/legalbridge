# LegalBridge API — environment variables template.
# Copy to .env for local development. On Railway, set each under
# Service → Settings → Variables.

# ── App identity ─────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info

# ── Supabase project ────────────────────────────────────────────────
# Your project URL (no trailing slash)
SUPABASE_URL=https://qcutjnsxiawnejiqwwix.supabase.co

# Supabase JWT signing secret — Project Settings → API → JWT Secret.
# DO NOT confuse with the anon / service_role keys. This one signs every
# auth token. You can find it under "Project API keys → JWT Secret".
SUPABASE_JWT_SECRET=__your_supabase_jwt_secret__

# Service role key — Project Settings → API → service_role (secret).
# Used for any DB / REST call that should bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=__your_service_role_key__

# Anon key — Project Settings → API → anon (public).
SUPABASE_ANON_KEY=__your_anon_key__

# ── Database (Supabase Postgres) ────────────────────────────────────
# Project Settings → Database → Connection string → URI
# Pick the "Transaction" pooler (port 6543) for short-lived web requests.
# Example:
#   postgresql://postgres.qcutjnsxiawnejiqwwix:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:__password__@db.qcutjnsxiawnejiqwwix.supabase.co:5432/postgres

# Optional connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO_SQL=false

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated. Add the Netlify preview URL too if you have one.
CORS_ALLOWED_ORIGINS=https://legalbridge.ng,https://www.legalbridge.ng

# ── JWT verification (defaults are correct for Supabase) ───────────
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=5

# Maximum provider stream duration before the request is cancelled.
PROVIDER_TIMEOUT_SECONDS=90
