{
  "expo": {
    "name": "LegalBridge",
    "slug": "legalbridge",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-owl.png",
    "scheme": "legalbridge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-owl.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b3e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.legalbridge.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-owl.png",
        "backgroundColor": "#0d1b3e"
      },
      "package": "ng.legalbridge.app",
      "versionCode": 12,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-owl.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0d1b3e"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LegalBridge uses the camera so you can point at documents, contracts or notes and discuss them live with LegalBridge AI.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "LegalBridge needs access to your photos so you can attach a document or image for the AI to analyse."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LegalBridge uses the microphone to turn your speech into text so you can dictate messages.",
          "speechRecognitionPermission": "LegalBridge uses speech recognition to convert your voice into text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f6eb0b7-c724-4807-9b8e-1801a2dcc008"
      }
    },
    "owner": "aboyai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5f6eb0b7-c724-4807-9b8e-1801a2dcc008",
      "fallbackToCacheTimeout": 0
    }
  }
}
